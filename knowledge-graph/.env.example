# Copy to .env and fill in locally. Never commit real credentials.

# MySQL source used by scripts/build_kg.py
ORBIT_MYSQL_HOST=localhost
ORBIT_MYSQL_PORT=3306
ORBIT_MYSQL_USER=orbit
ORBIT_MYSQL_PASSWORD=
ORBIT_MYSQL_DATABASE=public

# Neo4j target used by scripts/import_sqlite_to_neo4j.py and examples
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional LLM for the joint-reasoning notebook (leave empty to run offline)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Or: ANTHROPIC_API_KEY= / ANTHROPIC_MODEL=claude-sonnet-4-20250514
